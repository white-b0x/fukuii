# Blockchain & crypto
# Wallet keystore dir — root-anchored so it only ignores a node's datadir keystore at the
# repo root, NOT the legitimate `src/**/keystore/` Scala source dirs (KeyStore.scala,
# Wallet.scala, EncryptedKey*, and their specs), which are tracked source.
/keystore/
*.keystore
wallet.json
mnemonic.txt
etc-static-nodes.json
etc-node.key

# Local run configs
run-*.conf
run-*.sh
!.claude/looping/bin/run-loop.sh

